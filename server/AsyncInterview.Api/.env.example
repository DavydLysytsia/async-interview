# Copy this file to .env in the same folder and fill in real values.
# .env is gitignored — never commit real secrets.

# OAuth web credentials from Google Cloud Console (see docs/GOOGLE-SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the app, used to build the YouTube OAuth callback.
# Local development:
APP_BASE_URL=http://localhost:5240
# After deployment: https://<yourapp>.azurewebsites.net

# true = enable a local fake sign-in so the app is usable before Google
# credentials exist. Must be false in any deployed environment.
DEV_FAKE_AUTH=true

# SQLite database file (default: app.db next to the project).
# On Azure App Service use /home/data/app.db so the file persists.
#DB_PATH=app.db
